{
  "name": "node-microservices",
  "version": "2.0.0",
  "private": true,
  "description": "TypeScript microservices: API gateway, user/product/order/notification services, RabbitMQ events, Redis cache, Consul, Zipkin, Fluentd, Traefik, SeaweedFS",
  "workspaces": [
    "services/shared",
    "services/user-service",
    "services/product-service",
    "services/order-service",
    "services/notification-service",
    "api-gateway",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w @nms/shared && npm run build -w user-service -w product-service -w order-service -w notification-service -w api-gateway",
    "build:frontend": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:user": "npm run dev -w user-service",
    "dev:product": "npm run dev -w product-service",
    "dev:order": "npm run dev -w order-service",
    "dev:notification": "npm run dev -w notification-service",
    "dev:gateway": "npm run dev -w api-gateway",
    "dev:frontend": "npm run dev -w frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
