# Copy to .env (docker compose reads it) or export per service when running locally.

# --- Secrets (change all of these) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Shared by services for /internal/* calls (order-service -> user/product-service)
INTERNAL_API_TOKEN=change-me-internal-token
# Gateway -> service identity headers are trusted only with this secret
GATEWAY_SHARED_SECRET=change-me-gateway-secret
# Comma-separated emails that get the admin role on registration (and receive low-stock alerts)
ADMIN_EMAILS=admin@example.com

# --- Ports (local runs) ---
# api-gateway 3000, user 3001, product 3002, order 3003, notification 3004, frontend 3005
PORT=3000

# --- Data stores ---
MONGODB_URI=mongodb://localhost:27017/users
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENTS_EXCHANGE=microservices.events
RABBITMQ_PREFETCH=20

# --- Service URLs (static discovery; Consul overrides when configured) ---
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# --- Service discovery (Consul) ---
CONSUL_HOST=
CONSUL_PORT=8500
CONSUL_TOKEN=
# Address this service registers under (container/pod hostname by default)
SERVICE_ADDRESS=
HEARTBEAT_INTERVAL=30000
HEARTBEAT_TIMEOUT=60000
DISCOVERY_INTERVAL_MS=10000

# --- Circuit breaker ---
FAILURE_THRESHOLD=5
RESET_TIMEOUT=60000

# --- Gateway ---
GLOBAL_RATE_LIMIT=600
PROXY_TIMEOUT_MS=15000
CORS_ORIGIN=http://localhost:3005
TRAEFIK_API_URL=

# --- Tracing (Zipkin) ---
ZIPKIN_URL=
ZIPKIN_SERVICE_NAME=
ZIPKIN_SAMPLE_RATE=1

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
FLUENTD_HOST=
FLUENTD_PORT=24224
FLUENTD_TAG=nms

# --- File storage (SeaweedFS, user avatars) ---
SEAWEEDFS_SERVER=
SEAWEEDFS_PORT=9333
SEAWEEDFS_SCHEME=http

# --- Caching ---
USER_CACHE_TTL=3600
PRODUCT_CACHE_TTL=300
LOW_STOCK_THRESHOLD=5

# --- Email (notification-service). Without EMAIL_HOST mails are rendered but not delivered. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Node Microservices" <noreply@example.com>

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3000
